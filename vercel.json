{
  "cleanUrls": true,
  "headers": [
    { "source": "/", "headers": [ { "key": "Cache-Control", "value": "no-cache, must-revalidate" } ] },
    { "source": "/index.html", "headers": [ { "key": "Cache-Control", "value": "no-cache, must-revalidate" } ] },
    { "source": "/assets.json", "headers": [ { "key": "Cache-Control", "value": "no-cache, must-revalidate" } ] },
    { "source": "/a/(.*)", "headers": [ { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" } ] },
    { "source": "/models/(.*)", "headers": [ { "key": "Cache-Control", "value": "no-cache, must-revalidate" } ] },
    { "source": "/(.*)\\.usdz", "headers": [
      { "key": "Content-Type", "value": "model/vnd.usdz+zip" },
      { "key": "Access-Control-Allow-Origin", "value": "*" } ] },
    { "source": "/(.*)\\.glb", "headers": [
      { "key": "Content-Type", "value": "model/gltf-binary" },
      { "key": "Access-Control-Allow-Origin", "value": "*" } ] }
  ]
}
